+func newTestBridge(t *testing.T) *testBridge {
+	t.Helper()
+	hs := newFakeHomeserver(t)
+
+	rawDB, err := dbutil.NewWithDialect("file:"+filepath.Join(t.TempDir(), "test.db")+"?_foreign_keys=on", "sqlite3")
+	require.NoError(t, err)
+	t.Cleanup(func() { _ = rawDB.Close() })
+	rawDB.Log = dbutil.NoopLogger
+	db := database.New(rawDB, maulogger.Create())
+	require.NoError(t, db.Upgrade())
+
+	as := appservice.Create()
+	as.Registration = appservice.CreateRegistration()
+	as.Registration.SenderLocalpart = "discordbot"
+	as.HomeserverDomain = "test"
+	require.NoError(t, as.SetHomeserverURL(hs.server.URL))
+
+	nopLog := zerolog.Nop()
+	br := &DiscordBridge{
+		Bridge: bridge.Bridge{
+			AS:   as,
+			Bot:  as.BotIntent(),
+			ZLog: &nopLog,
+		},
+		Config: &config.Config{},
+		DB:     db,
+
+		portalsByID:   make(map[database.PortalKey]*Portal),
+		portalsByMXID: make(map[id.RoomID]*Portal),
+
+		threadsByID:                 make(map[string]*Thread),
+		threadsByRootMXID:           make(map[id.EventID]*Thread),
+		threadsByCreationNoticeMXID: make(map[id.EventID]*Thread),
