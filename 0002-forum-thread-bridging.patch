+// is about to become the thread root. For normal threads it is sent inside the existing
+// thread, relating to the already-known root.
+func (thread *Thread) sendCreationNotice(ctx context.Context) (id.EventID, error) {
+	var creationNotice string
+	if thread.IsForumPost {
+		creationNotice = "Forum post created. React to this message with \"join thread\" to join the thread on Discord."
+		if thread.Parent.bridge.Config.Bridge.AutojoinThreadOnOpen {
