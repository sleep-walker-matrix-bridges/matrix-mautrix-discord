+// makePortal inserts a portal row and registers an in-memory Portal for it.
+// If roomID is empty the portal exists but is not bridged to a Matrix room.
+func (tb *testBridge) makePortal(t *testing.T, channelID string, roomID id.RoomID) *Portal {
+	t.Helper()
+	dbPortal := tb.db.Portal.New()
+	dbPortal.Key = database.NewPortalKey(channelID, "")
+	dbPortal.MXID = roomID
+	dbPortal.Insert()
+	portal := &Portal{
+		Portal: dbPortal,
+		bridge: tb.br,
+		log:    zerolog.Nop(),
+	}
+	tb.br.portalsByID[dbPortal.Key] = portal
