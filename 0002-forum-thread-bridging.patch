+	// Create a message record with the thread ID set (this is what the fix ensures).
+	// Before the fix, this would have been empty because discordThreadID = thread.ID
+	// was gated on EnsureRoot success.
+	messagePart := database.MessagePart{
+		AttachmentID: "",
+		MXID:         "$evt1:test",
+	}
+
+	dbMsg := portal.markMessageHandled(
+		"test_message_123",
+		"test_author_456",
+		time.UnixMilli(1234567890),
+		thread.ID, // The fix ensures this is set unconditionally, not just on EnsureRoot success
+		"@testbot:test",
+		[]database.MessagePart{messagePart},
+	)
+	require.NotNil(t, dbMsg)
+
+	// The critical assertion: ThreadID must be set even though EnsureRoot failed.
+	assert.Equal(t, thread.ID, dbMsg.ThreadID, "ThreadID must be recorded even when EnsureRoot fails")
+
+	// Verify it's also persisted to the database.
+	reloaded := tb.db.Message.GetFirstByDiscordID(portal.Key, "test_message_123")
+	require.NotNil(t, reloaded)
+	assert.Equal(t, thread.ID, reloaded.ThreadID, "ThreadID must be persisted to database")
+
+	// Verify that DiscordProtoChannelID() correctly returns the thread ID, not the parent.
+	assert.Equal(t, thread.ID, reloaded.DiscordProtoChannelID(), "DiscordProtoChannelID must resolve to the thread, not the parent channel")
+}
