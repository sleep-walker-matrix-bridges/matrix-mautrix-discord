+// TestEnsureRootSendFailure checks that a failed send leaves no state suggesting success
+// and that a later call can still elect a root.
+func TestEnsureRootSendFailure(t *testing.T) {
+	tb := newTestBridge(t)
+	tb.makePortal(t, "parentchan", "!room:test")
+	tb.hs.failSends.Store(true)
+
+	thread := tb.br.GetForumPostThread("forumpost", "parentchan")
+	require.NotNil(t, thread)
+
+	root, err := thread.EnsureRoot(testCtx())
+	require.Error(t, err)
+	assert.Empty(t, root)
+	assert.Empty(t, thread.RootMXID)
+	assert.Empty(t, thread.CreationNoticeMXID)
+	assert.Empty(t, tb.db.Thread.GetByDiscordID("forumpost").RootMXID)
+	assert.Empty(t, tb.br.threadsByRootMXID)
+
+	// Recovery: once sends work again, the next caller elects the root.
+	tb.hs.failSends.Store(false)
+	root, err = thread.EnsureRoot(testCtx())
+	require.NoError(t, err)
+	assert.NotEmpty(t, root)
+	assert.Equal(t, root, tb.db.Thread.GetByDiscordID("forumpost").RootMXID)
+}
