+// threadCreateHandler processes THREAD_CREATE gateway events.
+// This handles both normal channel threads and forum post threads.
+func (user *User) threadCreateHandler(t *discordgo.ThreadCreate) {
+	// CRITICAL: Check t.Channel == nil FIRST, before any field access on t
+	// (including t.GuildID). Since discordgo.ThreadCreate embeds *Channel by pointer,
+	// all promoted field reads (t.GuildID, t.ParentID, etc.) dereference that pointer.
+	if t.Channel == nil {
+		user.log.Warn().Msg("ThreadCreate event has nil Channel, skipping")
+		return
+	}
+
+	if user.getGuildBridgingMode(t.GuildID) < database.GuildBridgeEverything {
+		user.log.Debug().
+			Str("guild_id", t.GuildID).Str("thread_id", t.ID).
+			Msg("Ignoring thread create event in unbridged guild")
+		return
+	}
+
+	log := user.log.With().
+		Str("action", "thread create").
+		Str("guild_id", t.GuildID).
+		Str("parent_id", t.ParentID).
+		Str("thread_id", t.ID).
+		Str("thread_type", fmt.Sprintf("%d", t.Type)).
+		Logger()
+	ctx := log.WithContext(context.Background())
+
+	// Determine if this is a forum post thread (parent is a forum channel)
+	// or a normal channel thread
+	parentChannel, err := user.Session.State.Channel(t.ParentID)
+	if err != nil || parentChannel == nil {
+		log.Warn().Err(err).Msg("Parent channel not found in state, skipping thread create")
+		return
+	}
+
+	// Check if parent is a forum or media channel - if so, this is a forum post
+	if parentChannel.Type == discordgo.ChannelTypeGuildForum || parentChannel.Type == discordgo.ChannelTypeGuildMedia {
+		log.Debug().Msg("New forum post thread created")
+		// THREAD_CREATE is only a hint for prompt live bridging: make sure a Thread row
+		// exists and eagerly elect the root. There is no retry or wait logic here - if
+		// this fails, the next message in the thread elects the root via EnsureRoot.
+		user.bridge.forumPostFound(ctx, user, t.ID, t.ParentID, t.Channel)
+	} else if t.Type == discordgo.ChannelTypeGuildPublicThread || t.Type == discordgo.ChannelTypeGuildPrivateThread || t.Type == discordgo.ChannelTypeGuildNewsThread {
+		// Normal channel thread - check if we have a root message
+		msg := user.bridge.DB.Message.GetByDiscordID(database.NewPortalKey(t.ParentID, ""), t.ID)
+		if len(msg) == 0 {
+			log.Debug().Msg("Thread created with no root message, skipping")
 		} else {
-			thread.Parent.ForwardBackfillMissed(user, meta.LastMessageID, thread)
+			log.Debug().Msg("New channel thread with root message, creating thread")
+			user.bridge.threadFound(ctx, user, msg[0], t.ID, t.Channel)
 		}
+	} else {
+		log.Debug().Msg("Unhandled thread type")
 	}
