+// TestEnsureRootConcurrent is the central regression test for the thread root election:
+// many goroutines race to get the root of the same fresh forum post, and exactly one
+// creation notice must be sent while every caller gets that same event ID back.
+func TestEnsureRootConcurrent(t *testing.T) {
+	tb := newTestBridge(t)
+	tb.makePortal(t, "parentchan", "!room:test")
+
+	thread := tb.br.GetForumPostThread("forumpost", "parentchan")
+	require.NotNil(t, thread)
+	require.True(t, thread.IsForumPost)
+	require.Empty(t, thread.RootMXID)
+
+	const goroutines = 32
+	results := make([]id.EventID, goroutines)
+	errs := make([]error, goroutines)
+	var start sync.WaitGroup
+	var done sync.WaitGroup
+	start.Add(1)
+	for i := 0; i < goroutines; i++ {
+		done.Add(1)
+		go func(i int) {
+			defer done.Done()
+			start.Wait()
+			results[i], errs[i] = thread.EnsureRoot(testCtx())
+		}(i)
+	}
+	start.Done()
+	done.Wait()
+
+	for i := 0; i < goroutines; i++ {
+		require.NoError(t, errs[i], "goroutine %d", i)
+		assert.NotEmpty(t, results[i], "goroutine %d got an empty root", i)
+		assert.Equal(t, results[0], results[i], "goroutine %d got a different root", i)
+	}
+	assert.EqualValues(t, 1, tb.hs.messageSends.Load(), "exactly one creation notice must be sent")
+
+	root := results[0]
+	assert.Equal(t, root, thread.RootMXID)
+	assert.Equal(t, root, thread.CreationNoticeMXID)
+
+	// The root must be durably recorded in the thread row before anything relates to it.
+	reloaded := tb.db.Thread.GetByDiscordID("forumpost")
+	require.NotNil(t, reloaded)
+	assert.Equal(t, root, reloaded.RootMXID)
+	assert.Equal(t, root, reloaded.CreationNoticeMXID)
+	assert.True(t, reloaded.IsForumPost)
+
+	// And registered in the lookup maps.
+	assert.Same(t, thread, tb.br.GetThreadByRootMXID(root))
+	assert.Same(t, thread, tb.br.GetThreadByRootOrCreationNoticeMXID(root))
+
+	// A later call is a pure memoized read: no further sends.
+	again, err := thread.EnsureRoot(testCtx())
+	require.NoError(t, err)
+	assert.Equal(t, root, again)
+	assert.EqualValues(t, 1, tb.hs.messageSends.Load())
+}
