+// TestIsForumPostMigration verifies the v25 migration backfills the discriminator for
+// rows written by the old code, which only ever left root_msg_mxid empty for forum posts.
+func TestIsForumPostMigration(t *testing.T) {
+	dbPath := filepath.Join(t.TempDir(), "migrate.db")
+
+	// Build a v24-era database and insert one forum-post-shaped and one normal row.
+	rawDB, err := sql.Open("sqlite3", "file:"+dbPath)
+	require.NoError(t, err)
+	old, err := dbutil.NewWithDB(rawDB, "sqlite3")
+	require.NoError(t, err)
+	old.Log = dbutil.NoopLogger
+	old.UpgradeTable = truncatedUpgradeTable(t, 24)
+	require.NoError(t, old.Upgrade())
+	for _, q := range []string{
+		`INSERT INTO portal (dcid, receiver, type, plain_name, name, name_set, topic, topic_set, avatar, avatar_url, avatar_set, encrypted, first_event_id, friend_nick, in_space) VALUES ('parentchan', '', 0, '', '', false, '', false, '', '', false, false, '', false, '')`,
+		`INSERT INTO thread (dcid, parent_chan_id, root_msg_dcid, root_msg_mxid, creation_notice_mxid) VALUES ('forumpost', 'parentchan', 'forumpost', '', '')`,
+		`INSERT INTO thread (dcid, parent_chan_id, root_msg_dcid, root_msg_mxid, creation_notice_mxid) VALUES ('plainthread', 'parentchan', 'rootmsg', '$root:test', '')`,
+	} {
+		_, err = old.Exec(q)
+		require.NoError(t, err, q)
+	}
+	require.NoError(t, old.Close())
+
+	// Reopen with the full upgrade table, running the new migration.
+	newRawDB, err := dbutil.NewWithDialect("file:"+dbPath, "sqlite3")
+	require.NoError(t, err)
+	newRawDB.Log = dbutil.NoopLogger
+	db := database.New(newRawDB, maulogger.Create())
+	require.NoError(t, db.Upgrade())
+	t.Cleanup(func() { _ = newRawDB.Close() })
+
+	forumPost := db.Thread.GetByDiscordID("forumpost")
+	require.NotNil(t, forumPost)
+	assert.True(t, forumPost.IsForumPost)
+
+	plain := db.Thread.GetByDiscordID("plainthread")
+	require.NotNil(t, plain)
+	assert.False(t, plain.IsForumPost)
+}
