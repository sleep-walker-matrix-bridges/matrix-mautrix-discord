+// ErrThreadParentNotBridged is returned by EnsureRoot when the thread's parent portal
+// does not exist yet or has no Matrix room. There is nothing to wait for in that case:
+// the caller decides what to do (usually: bridge the message to the main timeline
+// without recording it as part of the thread).
+var ErrThreadParentNotBridged = errors.New("thread parent portal is not bridged")
+
+// ErrThreadRootMissing is returned by EnsureRoot for a non-forum thread whose row has no
+// root message event. Normal threads are always created from an existing bridged root
+// message, so such a row is inconsistent and must not be self-rooted.
+var ErrThreadRootMissing = errors.New("thread row has no root event and is not a forum post")
+
+// EnsureRoot returns the Matrix event ID of this thread's root, electing (creating) it
+// if it doesn't exist yet.
+//
+// This is the single election point for a thread root: it is serialized by rootLock, so
+// exactly one caller ever sends the creation notice, and every caller returns with the
+// same event ID. When it returns a nil error, the returned event exists on the
+// homeserver and has been durably written to the thread row, so it is always safe to
+// send messages relating to it. When it returns an error, no thread state has been
+// modified and the caller must not mark its message as part of this thread.
+//
+// There is no waiting, no timeout and no background completion: the call either returns
+// a root immediately or performs the send inline and returns its result.
+func (thread *Thread) EnsureRoot(ctx context.Context) (id.EventID, error) {
+	thread.rootLock.Lock()
+	defer thread.rootLock.Unlock()
+
+	// Already elected: no I/O at all on this hot path.
+	if thread.RootMXID != "" {
+		return thread.RootMXID, nil
+	}
+	if !thread.IsForumPost {
+		return "", ErrThreadRootMissing
+	}
+	if thread.Parent == nil || thread.Parent.MXID == "" {
+		return "", ErrThreadParentNotBridged
+	}
+
+	// Forum posts have no pre-existing root message, so the creation notice itself is
+	// elected as the root: it is sent as a plain message with no thread relation, and
+	// the real event ID assigned by the homeserver becomes the thread anchor (MSC3440).
+	eventID, err := thread.sendCreationNotice(ctx)
+	if err != nil {
+		return "", err
+	}
+
+	prevRoot, prevNotice := thread.RootMXID, thread.CreationNoticeMXID
+	thread.RootMXID = eventID
+	thread.CreationNoticeMXID = eventID
+	if err = thread.saveMatrixIDs(); err != nil {
+		// Roll back the in-memory state so nothing suggests a successful election.
+		thread.RootMXID = prevRoot
+		thread.CreationNoticeMXID = prevNotice
+		return "", err
+	}
+
+	br := thread.Parent.bridge
+	br.threadsLock.Lock()
+	br.threadsByRootMXID[eventID] = thread
+	br.threadsByCreationNoticeMXID[eventID] = thread
+	br.threadsLock.Unlock()
+
+	zerolog.Ctx(ctx).Debug().
+		Str("thread_id", thread.ID).
+		Str("root_mxid", eventID.String()).
