+// fakeHomeserver is a minimal Matrix homeserver stub. It accepts every request and
+// counts the m.room.message sends, so tests can assert how many creation notices were
+// actually sent. Each send gets a unique event ID.
+type fakeHomeserver struct {
+	server *httptest.Server
+
+	messageSends atomic.Int64
+	eventCounter atomic.Int64
+
+	// failSends makes every m.room.message send return a 500.
+	failSends atomic.Bool
+}
+
+func newFakeHomeserver(t *testing.T) *fakeHomeserver {
+	t.Helper()
+	hs := &fakeHomeserver{}
+	hs.server = httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		switch {
+		case strings.Contains(r.URL.Path, "/send/m.room.message/"):
+			if hs.failSends.Load() {
+				w.WriteHeader(http.StatusInternalServerError)
+				_, _ = fmt.Fprint(w, `{"errcode":"M_UNKNOWN","error":"nope"}`)
+				return
+			}
+			hs.messageSends.Add(1)
+			n := hs.eventCounter.Add(1)
+			_, _ = fmt.Fprintf(w, `{"event_id":"$evt%d:test"}`, n)
+		case strings.Contains(r.URL.Path, "/send/"):
+			n := hs.eventCounter.Add(1)
+			_, _ = fmt.Fprintf(w, `{"event_id":"$evt%d:test"}`, n)
+		default:
+			// join, typing, register, ...
+			_, _ = fmt.Fprint(w, `{}`)
+		}
+	}))
+	t.Cleanup(hs.server.Close)
+	return hs
+}
