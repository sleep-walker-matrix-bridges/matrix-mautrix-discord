+// truncatedUpgradeTable returns the bridge's upgrade table cut off after version `to`,
+// so a test can build a database as it looked before a later migration.
+func truncatedUpgradeTable(t *testing.T, to int) dbutil.UpgradeTable {
+	t.Helper()
+	full := upgrades.Table
+	require.Greater(t, len(full), to, "upgrade table should have more entries than v%d", to)
+	return full[:to]
+}
