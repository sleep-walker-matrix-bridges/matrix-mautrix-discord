+// TestEnsureRootErrors covers the non-sending outcomes: EnsureRoot must return
+// immediately with an error rather than waiting for anything.
+func TestEnsureRootErrors(t *testing.T) {
+	tests := []struct {
+		name string
+		// setup returns the thread to test
+		setup   func(t *testing.T, tb *testBridge) *Thread
+		wantErr error
+	}{
+		{
+			name: "parent portal has no Matrix room",
+			setup: func(t *testing.T, tb *testBridge) *Thread {
+				tb.makePortal(t, "parentchan", "")
+				thread := tb.br.GetForumPostThread("forumpost", "parentchan")
+				require.NotNil(t, thread)
+				return thread
+			},
+			wantErr: ErrThreadParentNotBridged,
+		},
+		{
+			name: "parent portal object missing",
+			setup: func(t *testing.T, tb *testBridge) *Thread {
+				tb.makePortal(t, "parentchan", "!room:test")
+				thread := tb.br.GetForumPostThread("forumpost", "parentchan")
+				require.NotNil(t, thread)
+				thread.Parent = nil
+				return thread
+			},
+			wantErr: ErrThreadParentNotBridged,
+		},
+		{
+			name: "non-forum thread without a root event",
+			setup: func(t *testing.T, tb *testBridge) *Thread {
+				tb.makePortal(t, "parentchan", "!room:test")
+				dbThread := tb.db.Thread.New()
+				dbThread.ID = "plainthread"
+				dbThread.ParentID = "parentchan"
+				dbThread.RootDiscordID = "rootmsg"
+				dbThread.Insert()
+				return tb.br.GetThreadByID("plainthread", nil)
+			},
+			wantErr: ErrThreadRootMissing,
+		},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			tb := newTestBridge(t)
+			thread := test.setup(t, tb)
+			require.NotNil(t, thread)
+
+			root, err := thread.EnsureRoot(testCtx())
+			assert.ErrorIs(t, err, test.wantErr)
+			assert.Empty(t, root)
+			assert.Zero(t, tb.hs.messageSends.Load(), "nothing may be sent on an error path")
+		})
+	}
+}
