+// TestDiscordThreadIDRoutingCorrect verifies that DiscordProtoChannelID correctly uses
+// ThreadID when set, falling back to the channel only when ThreadID is empty.
+func TestDiscordThreadIDRoutingCorrect(t *testing.T) {
+	t.Run("message in thread", func(t *testing.T) {
+		msg := &database.Message{
+			Channel:  database.NewPortalKey("parentchan", ""),
+			ThreadID: "threadid123",
+		}
+		assert.Equal(t, "threadid123", msg.DiscordProtoChannelID())
+	})
+
+	t.Run("message in main channel", func(t *testing.T) {
+		msg := &database.Message{
+			Channel:  database.NewPortalKey("parentchan", ""),
+			ThreadID: "",
+		}
+		assert.Equal(t, "parentchan", msg.DiscordProtoChannelID())
+	})
+}
