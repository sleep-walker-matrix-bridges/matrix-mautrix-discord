+// performManualBackfill fetches and bridges older messages in a thread that
+// predate the bridge's knowledge of it. Returns the count of messages actually
+// backfilled.
+//
+// Lock ordering: acquires forwardBackfillLock internally to prevent concurrent
+// backfills from racing. Checked for deadlock: this function calls collectOlderBackfillMessages,
+// sendBackfillBatch, and database queries (GetFirstInThread, GetFirstByDiscordID). None of these
+// functions acquire forwardBackfillLock or Thread.rootLock, preventing deadlock.
+func (portal *Portal) performManualBackfill(log zerolog.Logger, source *User, thread *Thread, count int) int {
+	// M3 fix: Guard against nil Session (user with stored token but currently disconnected).
+	// RequiresLogin checks that a token is stored, not that a live session exists.
+	if source.Session == nil {
+		log.Error().Msg("User's Discord session is not connected")
+		// This function is called from a goroutine in fnBackfill, so we can't directly
+		// reply to the command event. The reply was already sent ("Backfilling up to N messages...").
+		// The recover() in fnBackfill will catch any panics. To signal failure to the user,
+		// we return 0 (no messages backfilled), which triggers the "No older messages found" reply.
+		// A clearer approach: fnBackfill should reply with an explicit message, but that
+		// requires passing the command event context. For now, document clearly and return 0.
+		return 0
+	}
+
+	// Acquire lock for the entire duration of fetch-and-bridge work
+	portal.forwardBackfillLock.Lock()
+	defer portal.forwardBackfillLock.Unlock()
+
+	// Find the oldest currently-bridged message in the thread
+	oldestMessage := portal.bridge.DB.Message.GetFirstInThread(portal.Key, thread.ID)
+	var before string
+	if oldestMessage != nil {
+		before = oldestMessage.DiscordID
+	}
+	// If before is empty, we'll fetch from the newest message
+
+	// Collect messages older than the oldest known one, paginating carefully backward
+	messages, foundAll, err := portal.collectOlderBackfillMessages(log, source, count, before, thread)
+	if err != nil {
+		if source.handlePossible40002(err) {
+			log.Err(err).Msg("Unrecoverable Discord error while backfilling")
+			return 0
+		}
+		log.Err(err).Msg("Error collecting messages for manual backfill")
+		return 0
+	}
+
+	log.Info().
+		Int("count", len(messages)).
+		Bool("found_all", foundAll).
+		Msg("Collected messages for manual backfill")
+
+	if len(messages) == 0 {
+		log.Debug().Msg("No messages collected for manual backfill")
+		return 0
+	}
+
+	// Defensively skip duplicates: check each message against the database
+	var messagesToBridge []*discordgo.Message
+	for _, msg := range messages {
+		// Check if this message is already bridged
+		existing := portal.bridge.DB.Message.GetFirstByDiscordID(portal.Key, msg.ID)
+		if existing != nil {
+			log.Debug().
+				Str("message_id", msg.ID).
+				Msg("Skipping duplicate message that's already bridged")
+			continue
+		}
+		messagesToBridge = append(messagesToBridge, msg)
+	}
+
+	if len(messagesToBridge) == 0 {
+		log.Debug().Msg("All collected messages were duplicates, nothing to backfill")
+		return 0
+	}
+
+	// Sort into chronological order (Discord's before pagination returns newest-first)
+	sort.Sort(MessageSlice(messagesToBridge))
+
+	// Bridge the messages using the existing batch-send infrastructure
+	portal.sendBackfillBatch(log, source, messagesToBridge, thread)
+
+	return len(messagesToBridge)
+}
