+// TestGetFirstInThread verifies that GetFirstInThread returns the oldest message
+// when multiple messages exist in a thread with different timestamps.
+func TestGetFirstInThread(t *testing.T) {
+	tb := newTestBridge(t)
+	portal := tb.makePortal(t, "test_channel", "!test:example.com")
+
+	threadID := "12345"
+	portalKey := portal.Key
+
+	// Insert messages with different timestamps
+	now := time.Now()
+	messages := []database.Message{
+		{
+			Channel:      portalKey,
+			DiscordID:    "msg1",
+			AttachmentID: "",
+			SenderID:     "user1",
+			Timestamp:    now.Add(2 * time.Hour), // Middle timestamp
+			ThreadID:     threadID,
+			MXID:         "!e1:test",
+			SenderMXID:   "@user1:test",
+		},
+		{
+			Channel:      portalKey,
+			DiscordID:    "msg2",
+			AttachmentID: "",
+			SenderID:     "user2",
+			Timestamp:    now, // Oldest timestamp
+			ThreadID:     threadID,
+			MXID:         "!e2:test",
+			SenderMXID:   "@user2:test",
+		},
+		{
+			Channel:      portalKey,
+			DiscordID:    "msg3",
+			AttachmentID: "",
+			SenderID:     "user3",
+			Timestamp:    now.Add(4 * time.Hour), // Newest timestamp
+			ThreadID:     threadID,
+			MXID:         "!e3:test",
+			SenderMXID:   "@user3:test",
+		},
+	}
+
+	// Insert all messages
+	tb.db.Message.MassInsert(portalKey, messages)
+
+	// GetFirstInThread should return the oldest message
+	first := tb.db.Message.GetFirstInThread(portalKey, threadID)
+	require.NotNil(t, first, "GetFirstInThread should return a message")
+	assert.Equal(t, "msg2", first.DiscordID, "Should return the oldest message")
+	// Compare timestamps with millisecond precision since DB stores in ms
+	assert.Equal(t, now.UnixMilli(), first.Timestamp.UnixMilli(), "Should have the earliest timestamp")
+}
