+
+// --- Real HTTP-level pagination test for collectOlderBackfillMessages ---
+//
+// Round 3's TestBackfillPaginationDirection only exercised compareMessageIDs and
+// sort.Sort(MessageSlice) plus code comments; it never called
+// collectOlderBackfillMessages and would have passed with the pagination logic
+// completely broken. It has been deleted and replaced by the test below, which
+// drives the real function through discordgo's real HTTP stack against a local
+// httptest.Server and asserts the exact sequence of `before` cursors that hit
+// the wire.
+//
+// discordgo hardcodes its endpoints (EndpointChannelMessages ->
+// https://discord.com/api/v9/channels/<id>/messages) but performs every REST
+// call through the exported Session.Client *http.Client, so installing a
+// http.RoundTripper that rewrites scheme+host (keeping path and query intact)
+// redirects the real request to our stub server. Nothing about
+// collectOlderBackfillMessages, ChannelMessages, URL building or JSON decoding
+// is mocked out.
+
+// discordRedirectTransport sends every request to target instead of discord.com,
+// preserving the path and query string that discordgo built.
+type discordRedirectTransport struct {
+	target *url.URL
+}
+
+func (t *discordRedirectTransport) RoundTrip(req *http.Request) (*http.Response, error) {
+	out := req.Clone(req.Context())
+	out.URL.Scheme = t.target.Scheme
+	out.URL.Host = t.target.Host
+	out.Host = t.target.Host
+	return http.DefaultTransport.RoundTrip(out)
+}
+
+// fakeDiscordAPI is a stub of GET /api/v9/channels/{id}/messages implementing
+// real Discord semantics: it holds a descending-by-ID history and returns the
+// newest `limit` messages strictly older than the `before` cursor.
+type fakeDiscordAPI struct {
+	server *httptest.Server
+
+	// wantPath is the only path the stub serves; anything else is recorded as
+	// unexpected and answered with 404 so an endpoint change fails loudly.
+	wantPath  string
+	channelID string
+	// history holds message IDs newest-first.
+	history []string
+
+	mu sync.Mutex
+	// beforeSeq records the raw `before` query parameter of each request, in order.
+	beforeSeq []string
+	// querySeq records the full raw query of each request, in order.
+	querySeq []string
+	// badRequests records requests to unexpected paths or with unexpected methods.
+	badRequests []string
+}
+
+func newFakeDiscordAPI(t *testing.T, channelID string, history []string) *fakeDiscordAPI {
+	t.Helper()
+	api := &fakeDiscordAPI{
+		wantPath:  "/api/v" + discordgo.APIVersion + "/channels/" + channelID + "/messages",
+		channelID: channelID,
+		history:   history,
+	}
+	api.server = httptest.NewServer(http.HandlerFunc(api.handle))
+	t.Cleanup(api.server.Close)
+	return api
+}
+
+func (api *fakeDiscordAPI) handle(w http.ResponseWriter, r *http.Request) {
+	api.mu.Lock()
+	if r.Method != http.MethodGet || r.URL.Path != api.wantPath {
+		api.badRequests = append(api.badRequests, r.Method+" "+r.URL.Path)
+		api.mu.Unlock()
+		w.WriteHeader(http.StatusNotFound)
+		_, _ = fmt.Fprint(w, `{"message":"404: Not Found","code":0}`)
+		return
+	}
+	q := r.URL.Query()
+	api.beforeSeq = append(api.beforeSeq, q.Get("before"))
+	api.querySeq = append(api.querySeq, r.URL.RawQuery)
+	api.mu.Unlock()
+
+	limit, err := strconv.Atoi(q.Get("limit"))
+	if err != nil || limit <= 0 {
+		limit = 50
+	}
+	// Discord semantics: return the newest `limit` messages strictly older than
+	// `before`. `after` and `around` are deliberately NOT implemented - if the
+	// code under test ever paginates forward, it gets no history at all.
+	start := 0
+	if before := q.Get("before"); before != "" {
+		start = len(api.history)
+		for i, id := range api.history {
+			if compareMessageIDs(id, before) < 0 {
+				start = i
+				break
+			}
+		}
+	}
+	end := start + limit
+	if end > len(api.history) {
+		end = len(api.history)
+	}
+	page := api.history[start:end]
+
+	var buf strings.Builder
+	buf.WriteString("[")
+	for i, id := range page {
+		if i > 0 {
+			buf.WriteString(",")
+		}
+		fmt.Fprintf(&buf, `{"id":%q,"channel_id":%q,"content":"message %s","timestamp":"2024-01-01T00:00:00Z","edited_timestamp":null,"author":{"id":"777","username":"fakeuser"}}`,
+			id, api.channelID, id)
+	}
+	buf.WriteString("]")
+	w.Header().Set("Content-Type", "application/json")
+	_, _ = io.WriteString(w, buf.String())
+}
+
+func (api *fakeDiscordAPI) recorded() ([]string, []string, []string) {
+	api.mu.Lock()
+	defer api.mu.Unlock()
+	return append([]string(nil), api.beforeSeq...), append([]string(nil), api.querySeq...), append([]string(nil), api.badRequests...)
+}
+
+// session returns a discordgo.Session whose REST calls are redirected to the stub.
+func (api *fakeDiscordAPI) session(t *testing.T) *discordgo.Session {
+	t.Helper()
+	target, err := url.Parse(api.server.URL)
+	require.NoError(t, err)
+	return &discordgo.Session{
+		Client:                 &http.Client{Transport: &discordRedirectTransport{target: target}},
+		Ratelimiter:            discordgo.NewRatelimiter(),
+		MaxRestRetries:         1,
+		ShouldRetryOnRateLimit: false,
+		UserAgent:              "mautrix-discord-test",
+		Token:                  "Bot test-token",
+	}
+}
+
+// snowflakeBase is an arbitrary fake-but-plausible Discord snowflake origin.
+// Higher ID == newer message.
+const snowflakeBase = int64(1000000000000000000)
+
+func snowflake(offset int64) string {
+	return strconv.FormatInt(snowflakeBase+offset, 10)
+}
+
+// descendingHistory builds message IDs newest-first for offsets high..low inclusive.
+func descendingHistory(high, low int64) []string {
+	ids := make([]string, 0, high-low+1)
+	for i := high; i >= low; i-- {
+		ids = append(ids, snowflake(i))
+	}
+	return ids
+}
+
+// TestCollectOlderBackfillMessagesPaginationDirection drives the real
+// collectOlderBackfillMessages against a stub Discord API and asserts the exact
+// sequence of `before` cursors that were sent over HTTP. This is what catches a
+// wrong-direction pagination bug: aggregated results alone can look plausible
+// even when the cursor walk is wrong.
+func TestCollectOlderBackfillMessagesPaginationDirection(t *testing.T) {
+	const threadID = "999888777"
+
+	t.Run("walks backwards from the starting cursor", func(t *testing.T) {
+		tb := newTestBridge(t)
+		portal := tb.makePortal(t, "test_channel", "!test:example.com")
+		thread := &Thread{Thread: &database.Thread{ID: threadID, ParentID: portal.Key.ChannelID}}
+
+		// 200 messages, offsets 199 (newest) down to 0 (oldest).
+		api := newFakeDiscordAPI(t, threadID, descendingHistory(199, 0))
+		source := &User{Session: api.session(t)}
+
+		// Start at offset 110: exactly 110 strictly-older messages remain
+		// (offsets 109..0), i.e. pages of 50, 50 and 10.
+		startingBefore := snowflake(110)
+		messages, foundAll, err := portal.collectOlderBackfillMessages(zerolog.Nop(), source, 120, startingBefore, thread)
+		require.NoError(t, err)
+
+		beforeSeq, querySeq, bad := api.recorded()
+		require.Empty(t, bad, "stub received unexpected requests")
+
+		// THE load-bearing assertion: the cursor walk must go backwards in time,
+		// each step using the OLDEST id of the previous page.
+		wantBefore := []string{
+			startingBefore, // page 1: offsets 109..60
+			snowflake(60),  // page 2: offsets 59..10
+			snowflake(10),  // page 3: offsets 9..0 (short page -> stop)
+		}
+		assert.Equal(t, wantBefore, beforeSeq, "sequence of `before` cursors sent to the Discord API")
+
+		// The cursor must travel via `before`, never `after`/`around`.
+		for i, raw := range querySeq {
+			q, perr := url.ParseQuery(raw)
+			require.NoError(t, perr)
+			assert.Equal(t, "50", q.Get("limit"), "request %d should fetch a full chunk", i)
+			assert.Empty(t, q["after"], "request %d must not use forward `after` pagination", i)
+			assert.Empty(t, q["around"], "request %d must not use `around` pagination", i)
+			assert.NotEmpty(t, q.Get("before"), "request %d must carry a `before` cursor", i)
+		}
+
+		// 50 + 50 + 10 = 110 collected, under the limit of 120, and the short
+		// final page means server history was exhausted.
+		assert.Len(t, messages, 110)
+		assert.True(t, foundAll, "short final page means all history was found")
+		require.NotEmpty(t, messages)
+		assert.Equal(t, snowflake(109), messages[0].ID, "first collected message is the newest one older than the cursor")
+		assert.Equal(t, snowflake(0), messages[len(messages)-1].ID, "last collected message is the oldest in history")
+		// Nothing newer than the starting cursor may be collected.
+		for _, msg := range messages {
+			assert.Less(t, compareMessageIDs(msg.ID, startingBefore), 0,
+				"collected message %s is not older than the starting cursor %s", msg.ID, startingBefore)
+		}
+		// The whole walk is strictly descending.
+		for i := 1; i < len(messages); i++ {
+			assert.Less(t, compareMessageIDs(messages[i].ID, messages[i-1].ID), 0,
+				"messages must be collected newest-first, but %s follows %s", messages[i].ID, messages[i-1].ID)
+		}
+	})
+
+	t.Run("stops at the limit without extra requests", func(t *testing.T) {
+		tb := newTestBridge(t)
+		portal := tb.makePortal(t, "test_channel", "!test:example.com")
+		thread := &Thread{Thread: &database.Thread{ID: threadID, ParentID: portal.Key.ChannelID}}
+
+		api := newFakeDiscordAPI(t, threadID, descendingHistory(199, 0))
+		source := &User{Session: api.session(t)}
+
+		startingBefore := snowflake(110)
+		messages, foundAll, err := portal.collectOlderBackfillMessages(zerolog.Nop(), source, 75, startingBefore, thread)
+		require.NoError(t, err)
+
+		beforeSeq, _, bad := api.recorded()
+		require.Empty(t, bad, "stub received unexpected requests")
+		// Two full pages (100 msgs) cross the limit of 75, so the loop stops
+		// there: exactly two requests, walking backwards.
+		assert.Equal(t, []string{startingBefore, snowflake(60)}, beforeSeq)
+		assert.Len(t, messages, 75)
+		assert.False(t, foundAll, "hitting the limit means history was not exhausted")
+		assert.Equal(t, snowflake(109), messages[0].ID)
+		assert.Equal(t, snowflake(35), messages[len(messages)-1].ID)
+	})
+
+	t.Run("empty starting cursor starts at the newest message", func(t *testing.T) {
+		tb := newTestBridge(t)
+		portal := tb.makePortal(t, "test_channel", "!test:example.com")
+		thread := &Thread{Thread: &database.Thread{ID: threadID, ParentID: portal.Key.ChannelID}}
+
+		api := newFakeDiscordAPI(t, threadID, descendingHistory(199, 0))
+		source := &User{Session: api.session(t)}
+
+		messages, foundAll, err := portal.collectOlderBackfillMessages(zerolog.Nop(), source, 120, "", thread)
+		require.NoError(t, err)
+
+		beforeSeq, querySeq, bad := api.recorded()
+		require.Empty(t, bad, "stub received unexpected requests")
+		// First request carries no cursor at all, then the walk goes backwards.
+		assert.Equal(t, []string{"", snowflake(150), snowflake(100)}, beforeSeq)
+		require.NotEmpty(t, querySeq)
+		firstQuery, perr := url.ParseQuery(querySeq[0])
+		require.NoError(t, perr)
+		assert.Empty(t, firstQuery["before"], "first request must omit `before` entirely")
+		assert.Empty(t, firstQuery["after"], "first request must not paginate forward")
+
+		// Three pages of 50 = 150 collected, truncated to the limit of 120.
+		assert.Len(t, messages, 120)
+		assert.False(t, foundAll, "truncation at the limit means history was not exhausted")
+		assert.Equal(t, snowflake(199), messages[0].ID)
+		assert.Equal(t, snowflake(80), messages[len(messages)-1].ID)
+	})
+}
diff --git a/commands.go b/commands.go
index 88b737c..c41f692 100644
--- a/commands.go
+++ b/commands.go
@@ -68,6 +68,7 @@ func (br *DiscordBridge) RegisterCommands() {
 		cmdGuilds,
 		cmdRejoinSpace,
 		cmdDeleteAllPortals,
+		cmdBackfill,
 		cmdExec,
 		cmdCommands,
 	)
@@ -899,3 +900,90 @@ func fnDeleteAllPortals(ce *WrappedCommandEvent) {
 		ce.Reply("Finished background cleanup of deleted portal rooms.")
 	}()
 }
+
+var cmdBackfill = &commands.FullHandler{
+	Func: wrapCommand(fnBackfill),
+	Name: "backfill",
+	Help: commands.HelpMeta{
+		Section:     HelpSectionPortalManagement,
+		Description: "Backfill older messages in a thread that were sent before the bridge joined",
+		Args:        "[_count_]",
+	},
+	RequiresPortal:     true,
+	RequiresEventLevel: roomModerator,
+	RequiresLogin:      true,
+}
+
+func fnBackfill(ce *WrappedCommandEvent) {
+	// Parse optional count argument (default 50, max 500)
+	count := 50
+	if len(ce.Args) > 0 {
+		if !isNumber(ce.Args[0]) {
+			ce.Reply("**Usage**: `$cmdprefix backfill [count]` — backfill up to _count_ older messages (default 50, max 500)")
+			return
+		}
+		parsed, _ := strconv.Atoi(ce.Args[0])
+		if parsed > 500 {
+			ce.Reply("Cannot backfill more than 500 messages at a time (you requested %d)", parsed)
+			return
+		}
+		count = parsed
+	}
+
+	// Resolve which thread to backfill based on ReplyTo
+	if ce.ReplyTo == "" {
+		ce.Reply("Reply to a message in the thread you want to backfill, e.g. `$cmdprefix backfill 100` as a reply to any message in that thread.")
+		return
+	}
+
+	var thread *Thread
+
+	// Try to get thread by root/creation notice first
+	thread = ce.Bridge.GetThreadByRootOrCreationNoticeMXID(ce.ReplyTo)
+	if thread == nil {
+		// Fall back to looking up by message ID
+		msg := ce.Bridge.DB.Message.GetByMXID(ce.Portal.Key, ce.ReplyTo)
+		if msg != nil && msg.ThreadID != "" {
+			thread = ce.Bridge.GetThreadByID(msg.ThreadID, nil)
+		}
+	}
+
+	// M1 fix: Verify the resolved thread actually belongs to this portal.
+	// A malicious/confused moderator could provide a root/creation notice event ID
+	// from a different channel's thread, causing us to leak that channel's messages
+	// into the wrong room, and to acquire the wrong portal's lock.
+	if thread != nil && (thread.Parent == nil || thread.Parent.Key != ce.Portal.Key) {
+		thread = nil
+	}
+
+	if thread == nil {
+		ce.Reply("That message isn't part of a bridged Discord thread, or I couldn't find it — reply to a message that's actually inside the thread you want to backfill.")
+		return
+	}
+
+	log := ce.ZLog.With().
+		Str("action", "manual backfill").
+		Str("thread_id", thread.ID).
+		Str("room_id", ce.Portal.MXID.String()).
+		Int("requested_count", count).
+		Logger()
+
+	// Send immediate feedback to user
+	ce.Reply("Backfilling up to %d older messages in this thread…", count)
+
+	// Perform the backfill in a goroutine to avoid blocking the command
+	go func() {
+		defer func() {
+			if r := recover(); r != nil {
+				log.Error().Interface("panic", r).Msg("Backfill goroutine panicked")
+			}
+		}()
+
+		backfilledCount := ce.Portal.performManualBackfill(log, ce.User, thread, count)
+		if backfilledCount == 0 {
+			ce.Reply("No older messages found in this thread to backfill.")
+		} else {
+			ce.Reply("Successfully backfilled %d messages in this thread.", backfilledCount)
+		}
+	}()
+}
