+// collectOlderBackfillMessages fetches messages from a thread that predate the
+// oldest currently-bridged message. Unlike collectBackfillMessages (which is used
+// for ForwardBackfillMissed and stops when reaching already-bridged messages),
+// this function paginates backwards from a starting point to genuinely fetch older,
+// never-before-bridged history.
+//
+// Arguments:
+//   - log: logger
+//   - source: User whose Discord session will be used for API calls
+//   - limit: maximum number of messages to return
+//   - before: Discord message ID to start pagination from (messages will be older than this ID).
+//     Pass "" if the thread has no bridged messages yet (will fetch from the newest message).
+//   - thread: Thread to fetch messages from
+//
+// Returns:
+//   - []*discordgo.Message: collected messages (newest-first within each page, pages concatenated)
+//   - bool: foundAll - true if we exhausted server-side history (got fewer than messageFetchChunkSize
+//     messages in a page), false if we hit the limit first
+//   - error: any error from API calls
+func (portal *Portal) collectOlderBackfillMessages(log zerolog.Logger, source *User, limit int, before string, thread *Thread) ([]*discordgo.Message, bool, error) {
+	var messages []*discordgo.Message
+	var foundAll bool
+	protoChannelID := portal.Key.ChannelID
+	if thread != nil {
+		protoChannelID = thread.ID
+	}
+	for {
+		log.Debug().Str("before_id", before).Msg("Fetching older messages for manual backfill")
+		// Fetch messages older than 'before' (or from newest if before is empty).
+		// ChannelMessages returns newest-first within the page.
+		newMessages, err := source.Session.ChannelMessages(protoChannelID, messageFetchChunkSize, before, "", "", portal.RefererOptIfUser(source.Session, protoChannelID)...)
+		if err != nil {
+			return nil, false, err
+		}
+		if len(newMessages) == 0 {
+			foundAll = true
+			break
+		}
+		messages = append(messages, newMessages...)
+		log.Debug().Int("count", len(newMessages)).Int("total", len(messages)).Msg("Fetched older messages for backfill")
+		// Check stopping conditions
+		if len(newMessages) < messageFetchChunkSize {
+			// Ran out of server-side history
+			foundAll = true
+			break
+		}
+		if len(messages) >= limit {
+			// Hit the limit
+			break
+		}
+		// Update before to the oldest message ID in the page so next call fetches even older
+		before = newMessages[len(newMessages)-1].ID
+	}
+	if len(messages) > limit {
+		foundAll = false
+		messages = messages[:limit]
+	}
+	return messages, foundAll, nil
+}
